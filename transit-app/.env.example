# Copy to .env.local (git-ignored) and fill in real values.
# This file is loaded by the Express API server (transit-app/server), NOT the browser.

# Hugging Face access token with the "Inference Providers" permission.
# Create one at: https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HF_TOKEN=

# Optional overrides. Must be a chat model available on the HF router
# (see https://router.huggingface.co/v1/models). Note: Llama models are gated —
# accept the license on the model page once while logged in to your HF account.
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
PORT=8787
